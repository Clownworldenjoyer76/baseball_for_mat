#!/usr/bin/env python3
"""
Item #12: measure MLB probability calibration by probability bucket for every market.

Uses the chronological OOS calibration predictions produced by item #8.

Production probability choice:
- moneyline: raw probability (calibration disabled by item #8 gate)
- run_line: calibrated probability
- total: calibrated probability

The script reports:
- 10 fixed probability buckets: [0.0,0.1), ... [0.9,1.0]
- rows per bucket
- mean predicted probability
- observed win rate
- calibration gap = predicted - observed
    positive => model overstates win probability
    negative => model understates win probability
- bootstrap 95% CI for the calibration gap
- explicit bias classification:
    overstates / understates / no_clear_bias / insufficient_n

"Systematic" bias requires:
- at least MIN_SYSTEMATIC_ROWS observations in the bucket, and
- the bootstrap 95% CI for predicted-minus-observed excludes zero.

Two OOS views are kept separate:
1. chronological_crossfit:
   only cross-fit predictions where calibration was fit strictly on earlier OOS folds
2. final_test_reference:
   the held-out final-test reference predictions already produced by item #8

Production is NOT modified.

Inputs:
- docs/win/baseball/mlb/modeling/probability_calibration/calibration_predictions.csv
- docs/win/baseball/mlb/models/probability_calibration/market_calibrators.json

Outputs:
- docs/win/baseball/mlb/modeling/probability_bucket_calibration/
    probability_bucket_metrics.csv
    systematic_bias_ranges.csv
    probability_bucket_summary.md
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path

import numpy as np
import pandas as pd

BASE_DIR = Path("docs/win/baseball/mlb")
DEFAULT_PREDICTIONS = (
    BASE_DIR
    / "modeling/probability_calibration/calibration_predictions.csv"
)
DEFAULT_ARTIFACT = (
    BASE_DIR
    / "models/probability_calibration/market_calibrators.json"
)
DEFAULT_OUTPUT_DIR = (
    BASE_DIR
    / "modeling/probability_bucket_calibration"
)

BUCKET_EDGES = np.linspace(0.0, 1.0, 11)
BUCKET_LABELS = [
    f"{i / 10:.1f}-{(i + 1) / 10:.1f}"
    for i in range(10)
]

MIN_SYSTEMATIC_ROWS = 30
BOOTSTRAP_DRAWS = 20000
RANDOM_SEED = 42


def find_repo_root() -> Path:
    starts = [Path.cwd().resolve(), Path(__file__).resolve().parent]
    for start in starts:
        for candidate in (start, *start.parents):
            if (candidate / BASE_DIR).is_dir():
                return candidate
    raise RuntimeError("Could not locate repository root")


def load_artifact(path: Path) -> dict:
    if not path.exists():
        raise FileNotFoundError(path)

    artifact = json.loads(
        path.read_text(encoding="utf-8")
    )
    if artifact.get("schema_version") != 1:
        raise RuntimeError(
            f"Unexpected calibration artifact schema: "
            f"{artifact.get('schema_version')}"
        )

    markets = artifact.get("markets")
    if not isinstance(markets, dict):
        raise RuntimeError(
            "Calibration artifact is missing markets"
        )

    expected = {
        "moneyline": False,
        "run_line": True,
        "total": True,
    }
    for market, expected_enabled in expected.items():
        if market not in markets:
            raise RuntimeError(
                f"Calibration artifact missing market: {market}"
            )
        actual = markets[market].get("enabled")
        if actual is not expected_enabled:
            raise RuntimeError(
                f"Unexpected item #8 status for {market}: "
                f"enabled={actual}; expected={expected_enabled}"
            )

    return artifact


def load_predictions(path: Path) -> pd.DataFrame:
    if not path.exists():
        raise FileNotFoundError(path)

    frame = pd.read_csv(path)
    required = {
        "market",
        "period",
        "game_date",
        "game_id",
        "contract",
        "y",
        "raw_p",
        "calibrated_p",
    }
    missing = sorted(required - set(frame.columns))
    if missing:
        raise RuntimeError(
            f"{path} missing required columns: {missing}"
        )

    frame = frame[
        frame["market"].isin(
            ["moneyline", "run_line", "total"]
        )
    ].copy()

    for col in ["y", "raw_p", "calibrated_p"]:
        frame[col] = pd.to_numeric(
            frame[col],
            errors="coerce",
        )
        bad = (
            frame[col].isna()
            | ~np.isfinite(frame[col])
        )
        if bad.any():
            raise RuntimeError(
                f"Invalid values in {col}: {int(bad.sum())}"
            )

    if (
        (frame["y"] < 0).any()
        or (frame["y"] > 1).any()
    ):
        raise RuntimeError(
            "Observed outcomes must be binary probabilities"
        )

    for col in ["raw_p", "calibrated_p"]:
        if (
            (frame[col] < 0).any()
            or (frame[col] > 1).any()
        ):
            raise RuntimeError(
                f"{col} contains probabilities outside [0,1]"
            )

    return frame.reset_index(drop=True)


def choose_production_probability(
    frame: pd.DataFrame,
    artifact: dict,
) -> pd.DataFrame:
    out = frame.copy()

    enabled = {
        market: bool(
            artifact["markets"][market]["enabled"]
        )
        for market in ["moneyline", "run_line", "total"]
    }

    out["production_probability"] = np.where(
        out["market"].map(enabled).astype(bool),
        out["calibrated_p"],
        out["raw_p"],
    )

    out["probability_source"] = np.where(
        out["market"].map(enabled).astype(bool),
        "calibrated",
        "raw",
    )

    return out


def attach_evaluation_view(
    frame: pd.DataFrame,
) -> pd.DataFrame:
    out = frame.copy()

    is_crossfit = (
        out["period"].astype(str).str.startswith("cv_fold_")
    )
    is_final = out["period"].eq("final_test")

    out["evaluation_view"] = np.select(
        [is_crossfit, is_final],
        [
            "chronological_crossfit",
            "final_test_reference",
        ],
        default="exclude",
    )

    out = out[
        out["evaluation_view"].ne("exclude")
    ].copy()

    if out.empty:
        raise RuntimeError(
            "No chronological cross-fit or final-test rows found"
        )

    return out


def bucketize(frame: pd.DataFrame) -> pd.DataFrame:
    out = frame.copy()

    # Include p=1.0 in the final bucket.
    values = np.clip(
        out["production_probability"].to_numpy(
            dtype=float
        ),
        0.0,
        1.0,
    )

    bucket_id = np.digitize(
        values,
        BUCKET_EDGES[1:-1],
        right=False,
    )
    out["bucket_id"] = bucket_id
    out["probability_bucket"] = [
        BUCKET_LABELS[int(i)]
        for i in bucket_id
    ]

    return out


def bootstrap_gap_ci(
    probabilities: np.ndarray,
    outcomes: np.ndarray,
    *,
    seed: int,
) -> tuple[float, float]:
    p = np.asarray(
        probabilities,
        dtype=float,
    )
    y = np.asarray(
        outcomes,
        dtype=float,
    )
    gap = p - y
    n = len(gap)

    if n == 0:
        return float("nan"), float("nan")

    rng = np.random.default_rng(seed)
    draws = np.empty(
        BOOTSTRAP_DRAWS,
        dtype=float,
    )

    chunk = 1000
    done = 0
    while done < BOOTSTRAP_DRAWS:
        size = min(
            chunk,
            BOOTSTRAP_DRAWS - done,
        )
        idx = rng.integers(
            0,
            n,
            size=(size, n),
        )
        draws[
            done : done + size
        ] = gap[idx].mean(axis=1)
        done += size

    low, high = np.quantile(
        draws,
        [0.025, 0.975],
    )
    return float(low), float(high)


def classify_bias(
    rows: int,
    gap: float,
    ci_low: float,
    ci_high: float,
) -> str:
    if rows < MIN_SYSTEMATIC_ROWS:
        return "insufficient_n"

    if ci_low > 0.0:
        return "overstates"

    if ci_high < 0.0:
        return "understates"

    return "no_clear_bias"


def build_bucket_metrics(
    frame: pd.DataFrame,
) -> pd.DataFrame:
    rows = []

    group_cols = [
        "evaluation_view",
        "market",
        "probability_source",
        "bucket_id",
        "probability_bucket",
    ]

    for keys, group in frame.groupby(
        group_cols,
        sort=True,
        observed=True,
    ):
        (
            evaluation_view,
            market,
            probability_source,
            bucket_id,
            bucket_label,
        ) = keys

        p = group[
            "production_probability"
        ].to_numpy(dtype=float)
        y = group["y"].to_numpy(dtype=float)

        mean_p = float(np.mean(p))
        observed = float(np.mean(y))
        gap = mean_p - observed

        seed = (
            RANDOM_SEED
            + sum(
                ord(c)
                for c in (
                    str(evaluation_view)
                    + str(market)
                    + str(bucket_label)
                )
            )
        )

        ci_low, ci_high = bootstrap_gap_ci(
            p,
            y,
            seed=seed,
        )

        rows.append(
            {
                "evaluation_view": str(
                    evaluation_view
                ),
                "market": str(market),
                "probability_source": str(
                    probability_source
                ),
                "probability_bucket": str(
                    bucket_label
                ),
                "bucket_low": float(
                    BUCKET_EDGES[int(bucket_id)]
                ),
                "bucket_high": float(
                    BUCKET_EDGES[
                        int(bucket_id) + 1
                    ]
                ),
                "rows": int(len(group)),
                "mean_predicted_probability": mean_p,
                "observed_win_rate": observed,
                "calibration_gap_pred_minus_obs": gap,
                "absolute_calibration_error": abs(gap),
                "gap_bootstrap_95_low": ci_low,
                "gap_bootstrap_95_high": ci_high,
                "bias_classification": classify_bias(
                    len(group),
                    gap,
                    ci_low,
                    ci_high,
                ),
            }
        )

    metrics = pd.DataFrame(rows)

    if metrics.empty:
        raise RuntimeError(
            "No probability bucket metrics produced"
        )

    return metrics.sort_values(
        [
            "evaluation_view",
            "market",
            "bucket_low",
        ]
    ).reset_index(drop=True)


def add_empty_buckets(
    metrics: pd.DataFrame,
) -> pd.DataFrame:
    records = []

    views = [
        "chronological_crossfit",
        "final_test_reference",
    ]
    markets = [
        ("moneyline", "raw"),
        ("run_line", "calibrated"),
        ("total", "calibrated"),
    ]

    lookup = {
        (
            row.evaluation_view,
            row.market,
            row.probability_bucket,
        ): row._asdict()
        for row in metrics.itertuples(index=False)
    }

    for view in views:
        for market, source in markets:
            for idx, label in enumerate(
                BUCKET_LABELS
            ):
                key = (
                    view,
                    market,
                    label,
                )
                if key in lookup:
                    records.append(
                        lookup[key]
                    )
                    continue

                records.append(
                    {
                        "evaluation_view": view,
                        "market": market,
                        "probability_source": source,
                        "probability_bucket": label,
                        "bucket_low": float(
                            BUCKET_EDGES[idx]
                        ),
                        "bucket_high": float(
                            BUCKET_EDGES[idx + 1]
                        ),
                        "rows": 0,
                        "mean_predicted_probability": np.nan,
                        "observed_win_rate": np.nan,
                        "calibration_gap_pred_minus_obs": np.nan,
                        "absolute_calibration_error": np.nan,
                        "gap_bootstrap_95_low": np.nan,
                        "gap_bootstrap_95_high": np.nan,
                        "bias_classification": "empty",
                    }
                )

    return pd.DataFrame(records).sort_values(
        [
            "evaluation_view",
            "market",
            "bucket_low",
        ]
    ).reset_index(drop=True)


def systematic_ranges(
    metrics: pd.DataFrame,
) -> pd.DataFrame:
    flagged = metrics[
        metrics["bias_classification"].isin(
            ["overstates", "understates"]
        )
    ].copy()

    if flagged.empty:
        return pd.DataFrame(
            columns=[
                "evaluation_view",
                "market",
                "probability_source",
                "probability_bucket",
                "rows",
                "mean_predicted_probability",
                "observed_win_rate",
                "calibration_gap_pred_minus_obs",
                "gap_bootstrap_95_low",
                "gap_bootstrap_95_high",
                "bias_classification",
            ]
        )

    return flagged[
        [
            "evaluation_view",
            "market",
            "probability_source",
            "probability_bucket",
            "rows",
            "mean_predicted_probability",
            "observed_win_rate",
            "calibration_gap_pred_minus_obs",
            "gap_bootstrap_95_low",
            "gap_bootstrap_95_high",
            "bias_classification",
        ]
    ].sort_values(
        [
            "evaluation_view",
            "market",
            "probability_bucket",
        ]
    ).reset_index(drop=True)


def write_summary(
    path: Path,
    metrics: pd.DataFrame,
    flagged: pd.DataFrame,
) -> None:
    lines = [
        "# Probability Bucket Calibration",
        "",
        "Production probability choice from item #8:",
        "",
        "- moneyline: raw probability",
        "- run line: calibrated probability",
        "- totals: calibrated probability",
        "",
        (
            "Calibration gap is `mean predicted probability - observed win rate`. "
            "Positive means the model overstates the win probability; negative means "
            "it understates it."
        ),
        "",
        (
            f"A bucket is labeled systematic only with at least "
            f"{MIN_SYSTEMATIC_ROWS} observations and a bootstrap 95% confidence "
            "interval for the calibration gap that excludes zero."
        ),
        "",
        "## Systematic bias ranges",
        "",
    ]

    if flagged.empty:
        lines.append(
            "No probability buckets met the systematic-bias rule."
        )
    else:
        lines.append(
            flagged.to_markdown(index=False)
        )

    for view in [
        "chronological_crossfit",
        "final_test_reference",
    ]:
        lines.extend(
            [
                "",
                f"## {view}",
                "",
            ]
        )
        subset = metrics[
            metrics["evaluation_view"].eq(view)
        ]
        lines.append(
            subset.to_markdown(index=False)
        )

    path.write_text(
        "\n".join(lines).rstrip() + "\n",
        encoding="utf-8",
    )


def print_focus(
    metrics: pd.DataFrame,
    flagged: pd.DataFrame,
) -> None:
    print(
        "Probability-bucket calibration complete."
    )
    print()
    print(
        "Systematic bias rule: "
        f"n >= {MIN_SYSTEMATIC_ROWS} and bootstrap "
        "95% CI for predicted-minus-observed excludes 0."
    )
    print()

    if flagged.empty:
        print(
            "Systematic bias ranges: NONE"
        )
    else:
        print(
            "Systematic bias ranges:"
        )
        display = flagged[
            [
                "evaluation_view",
                "market",
                "probability_bucket",
                "rows",
                "mean_predicted_probability",
                "observed_win_rate",
                "calibration_gap_pred_minus_obs",
                "gap_bootstrap_95_low",
                "gap_bootstrap_95_high",
                "bias_classification",
            ]
        ].copy()
        print(
            display.to_string(index=False)
        )

    print()
    print("Bucket coverage:")
    coverage = (
        metrics[
            metrics["rows"] > 0
        ]
        .groupby(
            [
                "evaluation_view",
                "market",
            ],
            as_index=False,
        )
        .agg(
            rows=("rows", "sum"),
            populated_buckets=(
                "probability_bucket",
                "count",
            ),
        )
    )
    print(
        coverage.to_string(index=False)
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Measure production MLB calibration by probability bucket"
        )
    )
    parser.add_argument(
        "--predictions",
        type=Path,
        default=DEFAULT_PREDICTIONS,
    )
    parser.add_argument(
        "--artifact",
        type=Path,
        default=DEFAULT_ARTIFACT,
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=DEFAULT_OUTPUT_DIR,
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = find_repo_root()

    predictions_path = (
        args.predictions
        if args.predictions.is_absolute()
        else root / args.predictions
    )
    artifact_path = (
        args.artifact
        if args.artifact.is_absolute()
        else root / args.artifact
    )
    output_dir = (
        args.output_dir
        if args.output_dir.is_absolute()
        else root / args.output_dir
    )

    artifact = load_artifact(
        artifact_path
    )
    predictions = load_predictions(
        predictions_path
    )
    predictions = choose_production_probability(
        predictions,
        artifact,
    )
    predictions = attach_evaluation_view(
        predictions
    )
    predictions = bucketize(
        predictions
    )

    metrics = build_bucket_metrics(
        predictions
    )
    metrics = add_empty_buckets(
        metrics
    )
    flagged = systematic_ranges(
        metrics
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    metrics_path = (
        output_dir
        / "probability_bucket_metrics.csv"
    )
    flagged_path = (
        output_dir
        / "systematic_bias_ranges.csv"
    )
    summary_path = (
        output_dir
        / "probability_bucket_summary.md"
    )

    metrics.to_csv(
        metrics_path,
        index=False,
    )
    flagged.to_csv(
        flagged_path,
        index=False,
    )
    write_summary(
        summary_path,
        metrics,
        flagged,
    )

    print_focus(
        metrics,
        flagged,
    )
    print()
    print(f"Metrics: {metrics_path}")
    print(f"Bias ranges: {flagged_path}")
    print(f"Summary: {summary_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
